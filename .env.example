# Copy to .env and fill in. .env is git-ignored and excluded from the Docker image; never commit real keys.

# --- LLM generation (RAG answers). Without a working key the assistant returns extractive, citation-only answers.
OPENAI_KEY=your_openai_key_here
# Legacy name used by the original PaperLens code; OPENAI_KEY takes precedence, either works.
OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4o-mini
# 1 = use a local Hugging Face instruct model if OpenAI fails (very slow on CPU)
RAG_USE_LOCAL_LLM=0

# --- Discovery
# Strongly recommended: the public Semantic Scholar pool rate-limits (HTTP 429) without a key
SEMANTIC_SCHOLAR_API_KEY=

# --- Legacy summary cache (optional; the app runs without it). Atlas URI, or mongodb://mongo:27017 with the compose "mongo" profile
MONGO_URI=

# --- Runtime
PORT=5000
STORAGE_DIR=./storage
DATA_DIR=./data
RANDOM_SEED=42
LOG_LEVEL=INFO
LOG_FORMAT=text          # json for containers
WARMUP=0                 # 1 = load models in the background at start-up
AUTOMATION=0             # 1 = start the scheduler (scheduled discovery, monitoring, benchmarking, reports)
